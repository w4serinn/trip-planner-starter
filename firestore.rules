rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 【重要】listを禁止すべきなのは groups コレクション直下だけ。
    // ここで list を禁止することで「全グループの合言葉を一覧取得して
    // 総当たりする」経路を塞ぐ。
    // 一方、groups/{groupCode} 配下（trips 以下のサブコレクション）は、
    // そのパスに到達する時点で正しい合言葉をすでに知っている必要があるため
    // list を許可してよい（でなければ候補地一覧・しおり一覧等、
    // アプリの表示機能そのものが動かなくなる）。
    // 参照: docs/firestore-design.md 「セキュリティ方針」

    match /groups/{groupCode} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;

      match /trips/{tripId} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if false;

        match /{subcollection}/{docId} {
          allow get, list: if true;
          allow create, update: if true;
          allow delete: if true;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
